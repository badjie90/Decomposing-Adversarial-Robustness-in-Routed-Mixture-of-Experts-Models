# Copy to configs/paths.env and replace these two dataset roots.
# BDD_IMAGE_ROOT contains images/100k and labels.
# NUIMAGES_IMAGE_ROOT contains samples and the metadata version directories.
BDD_IMAGE_ROOT=/path/to/bdd100k
NUIMAGES_IMAGE_ROOT=/path/to/nuimages
# Exported environment variables take precedence over values in this file.
# Optional overrides. Paths may be absolute or relative to this repository.
# OUTPUT_DIR=results
# PYTHON_BIN=python
# BDD_METADATA=data/metadata/bdd100k
# NUIMAGES_METADATA=data/metadata/nuimages
